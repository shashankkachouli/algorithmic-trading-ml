import os

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import yfinance as yf


START_DATE = "2015-01-01"
INDEX_TICKER = "^NSEI"


def calculate_rsi(series, window=14):
    delta = series.diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.rolling(window).mean()
    avg_loss = loss.rolling(window).mean()

    rs = avg_gain / avg_loss

    return 100 - (100 / (1 + rs))


def main():

    os.makedirs("data", exist_ok=True)
    os.makedirs("results", exist_ok=True)

    print("Downloading NIFTY 50 data...")

    df = yf.download(
        INDEX_TICKER,
        start=START_DATE,
        auto_adjust=True,
        progress=False,
    )

    # yfinance can return a MultiIndex even for one ticker
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)

    df = df.reset_index()

    # ---------------------------------------------------------
    # Returns
    # ---------------------------------------------------------

    df["return_1d"] = df["Close"].pct_change(fill_method=None)

    # ---------------------------------------------------------
    # Momentum
    # ---------------------------------------------------------

    df["momentum_10d"] = df["Close"].pct_change(
        periods=10,
        fill_method=None,
    )

    # ---------------------------------------------------------
    # Volatility
    # ---------------------------------------------------------

    df["volatility_20d"] = (
        df["return_1d"]
        .rolling(20)
        .std()
    )

    # ---------------------------------------------------------
    # Moving averages
    # ---------------------------------------------------------

    df["ma_20"] = df["Close"].rolling(20).mean()
    df["ma_50"] = df["Close"].rolling(50).mean()
    df["ma_200"] = df["Close"].rolling(200).mean()

    # ---------------------------------------------------------
    # RSI
    # ---------------------------------------------------------

    df["rsi_14"] = calculate_rsi(
        df["Close"],
        window=14,
    )

    # ---------------------------------------------------------
    # MACD
    # ---------------------------------------------------------

    df["ema_12"] = (
        df["Close"]
        .ewm(span=12, adjust=False)
        .mean()
    )

    df["ema_26"] = (
        df["Close"]
        .ewm(span=26, adjust=False)
        .mean()
    )

    df["macd"] = (
        df["ema_12"]
        - df["ema_26"]
    )

    df["macd_signal"] = (
        df["macd"]
        .ewm(span=9, adjust=False)
        .mean()
    )

    df["macd_hist"] = (
        df["macd"]
        - df["macd_signal"]
    )

    # ---------------------------------------------------------
    # Save
    # ---------------------------------------------------------

    output_path = "data/nifty_market_data.csv"

    df.to_csv(
        output_path,
        index=False,
    )

    print("\nDataset shape:", df.shape)
    print("\nDate range:")
    print(df["Date"].min(), "->", df["Date"].max())

    print("\nSample:")
    print(df.tail())

    print("\nSaved to:", output_path)

    # ---------------------------------------------------------
    # Plot
    # ---------------------------------------------------------

    plt.figure(figsize=(12, 6))

    plt.plot(
        df["Date"],
        df["Close"],
        label="NIFTY 50",
    )

    plt.plot(
        df["Date"],
        df["ma_200"],
        label="200-Day MA",
    )

    plt.title("NIFTY 50 Historical Price")
    plt.xlabel("Date")
    plt.ylabel("Adjusted Close")
    plt.legend()
    plt.grid(alpha=0.3)

    plt.tight_layout()

    plt.savefig(
        "results/nifty_history.png",
        dpi=300,
        bbox_inches="tight",
    )

    plt.close()


if __name__ == "__main__":
    main()
