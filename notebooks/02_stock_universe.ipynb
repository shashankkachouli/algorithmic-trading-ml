import os

import pandas as pd
import yfinance as yf


START_DATE = "2015-01-01"


TICKERS = [
    "ADANIENT.NS",
    "ADANIPORTS.NS",
    "APOLLOHOSP.NS",
    "ASIANPAINT.NS",
    "AXISBANK.NS",
    "BAJAJ-AUTO.NS",
    "BAJFINANCE.NS",
    "BAJAJFINSV.NS",
    "BEL.NS",
    "BHARTIARTL.NS",
    "CIPLA.NS",
    "COALINDIA.NS",
    "DRREDDY.NS",
    "EICHERMOT.NS",
    "ETERNAL.NS",
    "GRASIM.NS",
    "HCLTECH.NS",
    "HDFCBANK.NS",
    "HDFCLIFE.NS",
    "HEROMOTOCO.NS",
    "HINDALCO.NS",
    "HINDUNILVR.NS",
    "ICICIBANK.NS",
    "INDUSINDBK.NS",
    "INFY.NS",
    "ITC.NS",
    "JIOFIN.NS",
    "JSWSTEEL.NS",
    "KOTAKBANK.NS",
    "LT.NS",
    "M&M.NS",
    "MARUTI.NS",
    "NESTLEIND.NS",
    "NTPC.NS",
    "ONGC.NS",
    "POWERGRID.NS",
    "RELIANCE.NS",
    "SBILIFE.NS",
    "SBIN.NS",
    "SHRIRAMFIN.NS",
    "SUNPHARMA.NS",
    "TATACONSUM.NS",
    "TATAMOTORS.NS",
    "TATASTEEL.NS",
    "TCS.NS",
    "TECHM.NS",
    "TITAN.NS",
    "TRENT.NS",
    "ULTRACEMCO.NS",
    "WIPRO.NS",
]


def main():

    os.makedirs("data", exist_ok=True)

    print("Downloading stock universe...")
    print("Requested tickers:", len(TICKERS))

    data = yf.download(
        TICKERS,
        start=START_DATE,
        auto_adjust=True,
        group_by="column",
        progress=False,
    )

    # ---------------------------------------------------------
    # Convert yfinance MultiIndex to long format
    # ---------------------------------------------------------

    stock_df = data.stack(
        level="Ticker",
        future_stack=True,
    )

    stock_df.index.names = [
        "Date",
        "Ticker",
    ]

    stock_df = stock_df.reset_index()

    stock_df = stock_df.sort_values(
        ["Ticker", "Date"]
    ).reset_index(drop=True)

    # ---------------------------------------------------------
    # Basic diagnostics
    # ---------------------------------------------------------

    available_tickers = sorted(
        stock_df["Ticker"]
        .dropna()
        .unique()
    )

    missing = set(TICKERS) - set(available_tickers)

    print("\nRows:", len(stock_df))
    print("Downloaded stocks:", len(available_tickers))

    print("\nDate range:")
    print(
        stock_df["Date"].min(),
        "->",
        stock_df["Date"].max(),
    )

    if missing:
        print("\nTickers missing from downloaded dataset:")
        print(sorted(missing))

    print("\nObservations per ticker:")
    print(
        stock_df.groupby("Ticker")
        .size()
        .sort_values()
    )

    # ---------------------------------------------------------
    # Save raw universe
    # ---------------------------------------------------------

    output_path = "data/stock_universe_raw.csv"

    stock_df.to_csv(
        output_path,
        index=False,
    )

    print("\nSaved to:", output_path)


if __name__ == "__main__":
    main()
